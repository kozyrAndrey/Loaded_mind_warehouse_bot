# Новый токен после перевыпуска в BotFather.
BOT_TOKEN=
# Telegram user_id первого администратора; используется только при пустом справочнике.
BOOTSTRAP_ADMIN_IDS=
# PostgreSQL. На сервере сервисная ОС-учётная запись использует peer auth.
DATABASE_URL=postgresql+psycopg:///loaded_mind_warehouse?host=/var/run/postgresql

# Заполнить после команды /whereami в соответствующих темах.
GROUP_CHAT_ID=
RETURNS_TOPIC_ID=
RECEIVING_REPORT_TOPIC_ID=
SPECIAL_RECEIVING_REPORT_TOPIC_ID=
SCHEDULE_EXPORT_TOPIC_ID=
PAYROLL_REPORT_TOPIC_ID=
PAYROLL_PENALTIES_TOPIC_ID=
CONSUMABLES_TOPIC_ID=
DOCUMENT_WORKFLOW_CHAT_ID=
WAREHOUSE_INVOICES_TOPIC_ID=
ACTS_CLOSING_DOCUMENTS_TOPIC_ID=
RETURN_CHZ_CHAT_ID=
RETURN_CHZ_TOPIC_ID=
SUPPORT_MANAGER_MENTION=

# Новый токен отдельного аккаунта Loaded Mind в МойСклад.
MOYSKLAD_TOKEN=
MOYSKLAD_API_BASE_URL=https://api.moysklad.ru/api/remap/1.2
MOYSKLAD_SSL_VERIFY=true

# Реквизиты для крупной этикетки ЧЗ 75×120 мм.
MARKING_LABEL_CUSTOMER=
MARKING_LABEL_MANUFACTURER=
